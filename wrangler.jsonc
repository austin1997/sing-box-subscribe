{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sing-box-subscribe",
  "main": "worker.py",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "python_workers"
  ],
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "find_additional_modules": true,
  "base_dir": ".",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "templates/**/*.html"
      ],
      "fallthrough": true
    },
    {
      "type": "Text",
      "globs": [
        "config_template/**/*.json",
        "providers.json"
      ],
      "fallthrough": true
    }
  ]
}
